{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ea",
  "main": "./dist-ea/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-ea/client",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp"],
    "not_found_handling": "single-page-application"
  }
}
