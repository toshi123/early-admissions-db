{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site special selection search index v0.1",
  "type": "object",
  "required": ["artifact", "schema_version", "build_id", "records"],
  "additionalProperties": false,
  "properties": {
    "artifact": {"const": "early_admissions_special_selection_index"},
    "schema_version": {"const": "0.1"},
    "build_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "records": {"type": "array", "items": {
      "type": "object", "required": ["source_dataset", "source_version", "record_id", "flags"],
      "additionalProperties": false,
      "properties": {
        "source_dataset": {"enum": ["kokkoritsu", "shidai"]},
        "source_version": {"type": "string"},
        "record_id": {"type": "string", "minLength": 1},
        "flags": {"type": "object", "additionalProperties": false,
          "required": ["returnee_flag", "international_baccalaureate_flag", "private_foreign_student_flag", "adult_selection_flag"],
          "properties": {
            "returnee_flag": {"type": "boolean"},
            "international_baccalaureate_flag": {"type": "boolean"},
            "private_foreign_student_flag": {"type": "boolean"},
            "adult_selection_flag": {"type": "boolean"}
          }}
      }}
    }
  }
}
