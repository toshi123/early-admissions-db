{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:early-admissions:unified-schema:0.1",
  "title": "2027 Early Admissions Unified Dataset v0.1",
  "description": "Proposed loss-aware contract for combining kokkoritsu v5.61 and shidai v0.97 without modifying canonical source data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "master",
    "coverage",
    "research_requirements"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "master": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/masterRecord"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverageRecord"
      }
    },
    "research_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/researchRequirementRecord"
      }
    }
  },
  "x-contract-status": "proposal",
  "x-source-version-matrix": {
    "kokkoritsu": "5.61",
    "shidai": "0.97"
  },
  "x-null-semantics": {
    "null": "Source CSV cell is blank or the field is structurally not applicable.",
    "explicit_unknown": "Source explicitly records Unknown, unknown, or 不明 in a field whose enum supports it.",
    "negative": "No or false is an affirmative negative and must not be inferred from null, missing details, or missing child rows."
  },
