  "x-cross-record-validation": [
    {
      "code": "MASTER_PK_DUPLICATE",
      "severity": "error",
      "rule": "Master composite primary key must be unique."
    },
    {
      "code": "SOURCE_INSTITUTION_TYPE_MISMATCH",
      "severity": "error",
      "rule": "kokkoritsu rows must be 国立 or 公立; shidai rows must be 私立."
    },
    {
      "code": "RESEARCH_ORPHAN_FK",
      "severity": "error",
      "rule": "Every ResearchRequirements foreign key must resolve to Master in the same source dataset and version."
    },
    {
      "code": "COVERAGE_MASTER_ROWS_MISMATCH",
      "severity": "error",
      "rule": "Coverage.master_rows must equal the count of matching Master rows in the same source dataset and version."
    },
    {
      "code": "RESEARCH_REQUIRED_WITHOUT_CHILD",
      "severity": "warning",
      "rule": "Master research_requirement_required is Yes and no ResearchRequirements child row exists."
    },
    {
      "code": "RESEARCH_NOT_REQUIRED_WITH_CHILD",
      "severity": "informational",
      "rule": "Master research_requirement_required is No and one or more ResearchRequirements child rows exist."
    },
    {
      "code": "RESEARCH_EXACT_DUPLICATE",
      "severity": "warning",
      "rule": "Two or more ResearchRequirements rows are exactly equal after source_dataset and source_version are added; preserve them in v0.1."
    },
    {
      "code": "COMMON_TEST_FIELDS_DIFFER",
      "severity": "informational",
      "rule": "common_test_required and selection_common_test differ; the fields are distinct and no equality rule applies."
    }
  ],
  "x-derived-date-policy": {
    "base_fields_are_raw": true,
    "base_fields": [
      "application_start",
      "application_end",
      "web_registration_period",
      "first_stage_result_date",
      "second_stage_start",
      "second_stage_end",
      "final_result_date",
      "verified_on",
      "checked_on"
    ],
    "derived_search_fields_are_out_of_scope_for_v0_1": true,
    "ambiguous_parse_policy": "Do not guess; retain the raw value and use a derived parse status of unparsed or partial."
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceDataset": {
      "enum": [
        "kokkoritsu",
        "shidai"
      ]
    },
    "sourceVersion": {
      "enum": [
        "5.61",
        "0.97"
      ]
    },
    "sourcePairConstraint": {
      "allOf": [
        {
          "if": {
            "properties": {
              "source_dataset": {
                "const": "kokkoritsu"
              }
            },
            "required": [
              "source_dataset"
            ]
          },
          "then": {
            "properties": {
              "source_version": {
                "const": "5.61"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_dataset": {
                "const": "shidai"
              }
            },
            "required": [
              "source_dataset"
            ]
          },
          "then": {
            "properties": {
              "source_version": {
                "const": "0.97"
              }
            }
          }
        }
      ]
    },
    "sourceInstitutionConstraint": {
      "allOf": [
        {
          "if": {
            "properties": {
              "source_dataset": {
                "const": "kokkoritsu"
              }
            },
            "required": [
              "source_dataset"
            ]
          },
          "then": {
            "properties": {
              "institution_type": {
                "enum": [
                  "国立",
                  "公立"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_dataset": {
                "const": "shidai"
              }
            },
            "required": [
              "source_dataset"
            ]
          },
          "then": {
            "properties": {
              "institution_type": {
                "const": "私立"
              }
            }
          }
        }
      ]
    },
    "institutionType": {
      "enum": [
        "国立",
        "公立",
        "私立"
      ]
    },
    "triState": {
      "enum": [
        "Yes",
        "No",
        "Unknown",
        null
      ]
    },
    "commonTestRequired": {
      "enum": [
