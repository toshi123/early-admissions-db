    "guideline_index_checked",
    "master_compared",
    "kawai_crosscheck",
    "missing_candidate_count",
    "ambiguous_candidate_count",
    "obsolete_candidate_count",
    "update_queue_open_count",
    "last_audited_on",
    "notes"
