{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:early-admissions:provisional-admissions:0.1",
  "title": "2027 provisional admission discovery record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provisional_id", "university", "institution_type", "faculty_school", "selection_name", "information_year", "public_status", "known_scope", "known_detail", "unknown_detail", "official_source_url", "previous_year_source_url", "previous_year_detail", "release_expected_text", "verified_on", "related_update_queue_id"],
  "properties": {
    "provisional_id": {"type": "string", "pattern": "^PA-2027-[0-9]{4}$"},
    "university": {"type": "string", "minLength": 1},
    "institution_type": {"enum": ["国立", "公立", "私立"]},
    "faculty_school": {"type": ["string", "null"]},
    "selection_name": {"type": "string", "minLength": 1},
    "information_year": {"const": 2027},
    "public_status": {"enum": ["details_pending", "previous_year_reference", "publication_pending"]},
    "known_scope": {"type": "string", "minLength": 1},
    "known_detail": {"type": "string", "minLength": 1},
    "unknown_detail": {"type": "string", "minLength": 1},
    "official_source_url": {"type": "string", "pattern": "^https://"},
    "previous_year_source_url": {"type": ["string", "null"], "pattern": "^https://"},
    "previous_year_detail": {"type": ["string", "null"]},
    "release_expected_text": {"type": ["string", "null"]},
    "verified_on": {"type": "string", "format": "date"},
    "related_update_queue_id": {"type": ["string", "null"], "pattern": "^UQ-2027-(?:[0-9]{4}|1[0-9]{2})$"}
  },
  "allOf": [
    {"if": {"properties": {"public_status": {"const": "previous_year_reference"}}}, "then": {"properties": {"previous_year_source_url": {"type": "string", "minLength": 9}, "previous_year_detail": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"public_status": {"const": "publication_pending"}}}, "then": {"properties": {"release_expected_text": {"type": "string", "minLength": 1}}}}
  ]
}
