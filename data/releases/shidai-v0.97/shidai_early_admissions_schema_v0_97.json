  "schema_basis": "早期入試DB JSON Schema 引継ぎ仕様 v0.8",
  "target_admission_year": 2027,
  "grain": "1 row = one actual application unit / selection slot",
  "canonical_data": {
    "master": "shidai_early_admissions_2027_master_v0_97.csv",
    "coverage": "shidai_early_admissions_2027_coverage_v0_97.csv",
